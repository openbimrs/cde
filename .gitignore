# Copyrighted standards kept as local research material only. Keep this broad
# so moving the local corpus cannot accidentally expose licensed PDFs to Git.
references/**/*.pdf

/target/

# Ad-hoc `git worktree add .worktrees/<name>` scratch space for review/gate
# candidates. Never commit — these are throwaway checkouts of already-tracked
# refs, cleaned up with `git worktree remove` when done.
/.worktrees/
